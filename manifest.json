{
  "manifest_version": 3,
  "name": "Onliner Price Tracker",
  "version": "1.0.0",
  "description": "Watch product prices on catalog.onliner.by, keep local history, and get notified on drops.",
  "permissions": ["storage", "alarms", "notifications"],
  "host_permissions": [
    "https://catalog.onliner.by/*",
    "https://catalog.api.onliner.by/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "Onliner Price Tracker",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://catalog.onliner.by/*/*/*"],
      "exclude_matches": [
        "https://catalog.onliner.by/*/*/*/reviews*",
        "https://catalog.onliner.by/*/*/*/prices*",
        "https://catalog.onliner.by/*/*/*/used*",
        "https://catalog.onliner.by/*/*/*/forum*"
      ],
      "js": ["src/shared.js", "src/content.js"],
      "css": ["src/content.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
